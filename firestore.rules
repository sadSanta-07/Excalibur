rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // No auth by design (see README). Anyone with a canvas link can read/edit it.
    match /canvases/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.data == null
                            || request.resource.data.data.size() < 900000; // stay under Firestore's 1 MB doc limit
      allow delete: if true;
    }
  }
}
